# NURSELINK_ADMIN_PHYSICAL_V537_START
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin(?:/.*)?$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
# NURSELINK_ADMIN_PHYSICAL_V537_END
